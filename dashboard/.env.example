# BrowserMesh control plane the dashboard talks to.
#
# Local kind (default):
BROWSERMESH_CONTROL_URL=http://127.0.0.1:30080
NEXT_PUBLIC_BROWSERMESH_CONTROL_WS=ws://127.0.0.1:30080
#
# Remote, e.g. GKE NodePort — uncomment and set your control's public URL:
# BROWSERMESH_CONTROL_URL=http://34.30.38.64:30080
# NEXT_PUBLIC_BROWSERMESH_CONTROL_WS=ws://34.30.38.64:30080
