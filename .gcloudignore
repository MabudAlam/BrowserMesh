*.py[cod]
*.egg-info/
.venv/
venv/
node_modules/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts
.env
.env.*
!.env.example
logs/
*.log
.DS_Store
tmp/
.idea/
.vscode/
